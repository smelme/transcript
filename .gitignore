# Dependencies
# Lockfiles are committed on purpose: CI installs with `npm ci`, which refuses to run without
# one, and a reproducible install is the whole point of a workspace-based project.
node_modules/
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.local
.env.*.local
.env.*.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/
*.tmp
.cache/

# Mobile
.gradle/
.android/
*.keystore
build-cache/
local.properties

# Database
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
# Anchored: a bare `data/` also matched source packages such as
# mobile-wallet/app/src/main/kotlin/.../wallet/data, silently ignoring new files.
/data/

# Testing
.jest/
playwright-report/
test-results/

# Keys & Secrets (NEVER commit)
*.pem
*.key
secrets/
.keys/

# Runtime share persistence
/issuer-service/data/
/verifier-service/data/

# TypeScript incremental build state
*.tsbuildinfo

# Test output: the key-management tests generate keys here on every run, including a private one.
/key-management/test-keys/
