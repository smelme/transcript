{
  "name": "issuer-service",
  "version": "0.1.0",
  "description": "Issuer Service - mDoc credential generation and management",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "echo 'No build step required for Node.js backend'",
