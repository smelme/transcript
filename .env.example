# Environment for the deployed system.
#
# Local development needs none of this: START_LOCAL_SERVICES.ps1 supplies working defaults, and
# email is deliberately switched off. Every value here matters in a deployment, and the two that
# are easy to get wrong are marked below.

NODE_ENV=production

# ── Storage ───────────────────────────────────────────────────────────────────────────────────
# Point this at a mounted volume, or every deploy begins with an empty database.
DATABASE_PATH=/data/transcript.db

# Shares are kept in a file as well as in memory, so give them the same volume.
SHARE_DATA_DIR=/data/shares

# ── Identity ──────────────────────────────────────────────────────────────────────────────────
# WRONG HERE IS PERMANENT: these two are written inside every credential as the address a verifier
# fetches to check revocation, so a localhost value cannot be corrected for credentials already
# issued. Set them before issuing anything.
STATUS_LIST_BASE_URL=https://issuer.example
ISSUER_BASE_URL=https://issuer.example
ACADEMY_SITE_URL=https://academy.example

# The academy also exposes the same offer as an Android App Link.
WALLET_APP_LINK_BASE=https://academy.example/offer

# ── Signer keys ───────────────────────────────────────────────────────────────────────────────
# The private keys are not in the repository. In a deployment they arrive as variables, and the
# step that runs before the issuer starts writes them onto the volume at the paths below.
MDOC_SIGNER_KEY_PEM=
WALLET_TOKEN_SIGNER_KEY_PEM=
MDOC_SIGNER_KEY_PATH=/data/keys/mdoc-signer.private.pem
WALLET_TOKEN_SIGNER_KEY_PATH=/data/keys/wallet-token-signer.private.pem

# ── Email ─────────────────────────────────────────────────────────────────────────────────────
# Without these, shares and sign-in codes are silently not sent.
BREVO_API_KEY=
FROM_EMAIL=registrar@example.ac.nz
FROM_NAME=Smart Academy

# ── Administrators ────────────────────────────────────────────────────────────────────────────
# ADMIN_* has a development default, so set it. It manages every organisation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ACADEMY_ADMIN_EMAIL=
ACADEMY_ADMIN_PASSWORD=
ACADEMY_NAME=Smart Academy

# ── Identity documents, if the KYC checks are used ────────────────────────────────────────────
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
APP_BASE_URL=https://issuer.example

# ── Front-ends ───────────────────────────────────────────────────────────────────────────────
# Each app proxies /api/* to a service. Unset, they proxy to localhost.
ISSUER_API_URL=https://issuer.example
VERIFIER_API_URL=https://verifier.example

# The student-facing site, used for links in email and for the wallet app link.
ISSUER_FRONTEND_URL=https://academy.example

# Who may call the services from a browser. Comma separated, no spaces.
CORS_ORIGINS=https://issuer.example,https://verifier.example,https://academy.example
